# Normalización de finales de línea — los archivos de texto del repo usan LF
# también en Windows, para que los scripts, los .strings y el proyecto Xcode
# se comporten igual en cualquier máquina.
* text=auto
*.swift text eol=lf
*.strings text eol=lf
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Makefile text eol=lf
LICENSE text eol=lf
*.png binary
